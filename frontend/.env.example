## Frontend environment variables
# Set this to your backend API URL (Railway example below). Keep /api at the end.
# Example (Railway): https://sincere-transformation-production-b923.up.railway.app/api
VITE_API_URL=https://<your-backend-domain>.up.railway.app/api

# Required when gym-owner marketing is deployed separately from the main API.
# Set this to the FastAPI marketing service origin (without /api), then rebuild and redeploy.
VITE_MARKETING_API_URL=

# Public web app URL used for shareable Reel links in native Android builds.
VITE_APP_URL=https://<your-frontend-domain>

# Optional: If frontend needs a direct OpenAI key (not recommended for production)
VITE_OPENAI_API_KEY=
